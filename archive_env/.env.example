# ReDNA Demos - Environment Configuration Example
# Copy this file to .env and fill in your values

# === LLM API Keys (Sprint 2a) ===
# OpenAI (required for llm_provider="openai")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (required for llm_provider="anthropic")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama (local LLM, optional)
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# === Service Ports ===
CORE_PORT=8001
UCNRR_PORT=8002
REACT_PORT=3001

# === Service URLs ===
UCNRR_BASE=http://127.0.0.1:8002
CORE_BASE=http://127.0.0.1:8001

# === Head Coach Settings ===
HC_CHAT_ENABLED=true
HC_CHAT_PROVIDER=openai  # or "anthropic", "ollama", "mock"

# === Feature Flags ===
CORE_CURIOSITY_ENABLED=true
DEV_EXPLORER_ENABLED=true
WRITE_PROTECT=false

# === Other Settings ===
PHOTO_IMPORT_STRICT=false
ENABLE_SOFT_IMPORT_ASSIST=true
CORE_HOLISTIC_ON_INGEST=true
CORE_HOLISTIC_USE_LLM=true
