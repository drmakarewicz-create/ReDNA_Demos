{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coach Packet",
  "description": "Data structure returned by coach sandbox runs",
  "type": "object",
  "required": ["coach_id", "turn_count", "messages"],
  "properties": {
    "coach_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Coach identifier"
    },
    "turn_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of conversation turns"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system"]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "prompt_hash": { "type": "string" },
        "features_hash": { "type": "string" },
        "duration_ms": { "type": "number" },
        "tokens_used": { "type": "integer" }
      }
    }
  }
}
