      "scale": {
        "min": 1,
        "max": 7,
        "labels": {
          "1": "Rarely/Never",
          "4": "Sometimes",
          "7": "Very Often"
        }
      },
      "difficulty": "easy",
      "evidence_weight": 0.7
    },
