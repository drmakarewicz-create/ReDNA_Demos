{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.redna.dev/bundle/v1",
  "title": "ReDNA Bundle v1",
  "type": "object",
  "required": ["meta", "resolved"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "user_id"],
      "properties": {
        "version": {"type": "string"},
        "user_id": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "resolved": {"type": "object"},
    "evidence": {"type": ["object", "null"]},
    "observations": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
