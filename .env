# UCNRR LLM Configuration (Ollama defaults)
UCNRR_LLM_PROVIDER=ollama
UCNRR_LLM_MODEL=llama3.1:8b

# Legacy aliases (backward compatibility)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
