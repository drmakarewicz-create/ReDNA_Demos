# Default environment overrides for ReDNA services
PHOTO_IMPORT_STRICT=false
ENABLE_SOFT_IMPORT_ASSIST=true
SOFT_IMPORT_ASSIST_TIMEOUT_MS=1500
CORE_HOLISTIC_ON_INGEST=true
CORE_HOLISTIC_MAX_MS=5000
CORE_HOLISTIC_USE_LLM=true
CORE_HOLISTIC_LLM_BUDGET_MS=15000
CORE_HOLISTIC_SCHEDULE_ENABLED=true
CORE_HOLISTIC_SCHEDULE_DAYS=7
PERSONA_DEV_TABS=true

# CReDNA (planned) — do not enable yet
# CREDNA_ENABLED=false
# CREDNA_REVIEW_INTERVAL_DAYS=7
# CREDNA_AUTO_PROPAGATE=false
DEV_EXPLORER_ENABLED=true
WRITE_PROTECT=false
DEMO_BASELINES_ENABLED=false
CORE_CURIOSITY_ENABLED=true
DEV_LOOPTEST_USER_ID=devexp_test
DEV_HTTP_TIMEOUT_SECONDS=36.0
AUDIT_VIEWER_ENABLED=true
HC_OPS_ENABLED=false
NUDGE_INBOX_ENABLED=false
FEEDBACK_ENABLED=false
HC_SEND_ENABLED=false

# === ReDNA Core / Head Coach ===
HC_CHAT_ENABLED=true
HC_CHAT_PROVIDER=ollama

# Ollama (local LLM)
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
