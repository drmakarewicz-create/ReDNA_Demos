#!/usr/bin/env bash
set -euo pipefail

# Prevent accidental commits of very large binaries unless explicitly allowed.

if [[ "${SKIP_HOOKS:-0}" == "1" || -n "${CI:-}" ]]; then
  exit 0
fi

THRESHOLD=$((10 * 1024 * 1024)) # 10 MB
ALLOWED_EXTENSIONS=("md" "txt" "rst" "csv" "tsv" "json" "jsonl" "yaml" "yml" "toml" "ini" "cfg" "conf")

# Portable alternative to mapfile for compatibility
staged_files=()
while IFS= read -r file; do
  staged_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=AM)

if [[ ${#staged_files[@]} -eq 0 ]]; then
  exit 0
fi

declare -a blocked

to_lower() {
  echo "$1" | tr '[:upper:]' '[:lower:]'
}

is_allowed_extension() {
  local ext="$(to_lower "$1")"
  for allowed in "${ALLOWED_EXTENSIONS[@]}"; do
    if [[ "${ext}" == "${allowed}" ]]; then
      return 0
    fi
  done
  return 1
}

file_size() {
  local target="$1"
  stat -f%z "${target}" 2>/dev/null || stat -c%s "${target}"
}

size_in_mb() {
  python3 - "$1" <<'PYCODE'
import sys
size = int(sys.argv[1])
print(f"{size/1048576:.2f}")
PYCODE
}

is_lfs_tracked() {
  local file="$1"
  local attr
  attr="$(git check-attr filter -- "${file}" 2>/dev/null | awk -F': ' '{print $3}')"
  [[ "${attr}" == "lfs" ]]
}

for file in "${staged_files[@]}"; do
  if [[ ! -f "${file}" ]]; then
    continue
  fi
  size="$(file_size "${file}")"
  if [[ ! "${size}" =~ ^[0-9]+$ || ${size} -le ${THRESHOLD} ]]; then
    continue
  fi

  extension="${file##*.}"
  if [[ "${file}" == "${extension}" ]]; then
    extension=""
  fi

  if [[ -n "${extension}" ]] && is_allowed_extension "${extension}"; then
    continue
  fi

  if is_lfs_tracked "${file}"; then
    continue
  fi

  blocked+=("${file} ($(size_in_mb "${size}") MB)")
done

if [[ ${#blocked[@]} -gt 0 ]]; then
  echo "pre-commit: blocked files exceed ${THRESHOLD} bytes (10 MB):" >&2
  for entry in "${blocked[@]}"; do
    echo "  - ${entry}" >&2
  done
  echo "Use Git LFS or set SKIP_HOOKS=1 to override intentionally." >&2
  exit 1
fi

exit 0
