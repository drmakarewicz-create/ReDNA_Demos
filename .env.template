
# Copy this file to `.env` and fill in your own local secrets
# Never commit your `.env` file — only this template should be tracked.

OPENAI_API_KEY=
# Example:
# OPENAI_API_KEY=

# Add any other service keys below:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DATABASE_URL=

VITE_DEVX_ADMIN_TOKEN=

# === DevX (Developer Explorer) Bootstrap Settings ===
# Python interpreter to use (leave empty to use current Python)
DEVX_PY=
# DevX backend (FastAPI) port
DEVX_BACKEND_PORT=8100
# DevX UI (Streamlit) port
DEVX_UI_PORT=8550
# Backend entry point (if not using uvicorn module)
DEVX_BACKEND_ENTRY=ReDNACoreDemo/devx/backend/main.py
# UI entry point
DEVX_UI_ENTRY=ExplorerDev/explorer_dev.py
# Requirements file for DevX dependencies
DEVX_REQUIREMENTS=ExplorerDev/requirements.txt
