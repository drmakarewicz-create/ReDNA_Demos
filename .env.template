
# Copy this file to `.env` and fill in your own local secrets
# Never commit your `.env` file — only this template should be tracked.

OPENAI_API_KEY=
# Example:
# OPENAI_API_KEY=

# Add any other service keys below:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DATABASE_URL=

VITE_DEVX_ADMIN_TOKEN=

# === DevX (Developer Experience) Bootstrap Settings ===
# Python interpreter to use (leave empty to use current Python)
DEVX_PY=
# DevX backend (FastAPI) port
DEVX_BACKEND_PORT=8100
# DevX UI (React/Vite) port
DEVX_UI_PORT=3100
# DevX UI directory (React frontend)
DEVX_UI_DIR=ReDNACoreDemo/devx/frontend
# Backend entry point (if not using uvicorn module)
DEVX_BACKEND_ENTRY=ReDNACoreDemo/devx/backend/run_devx.py
# Optional: enable verbose logging to ~/.redna/devx_*.log
DEVX_VERBOSE_LOGS=false
